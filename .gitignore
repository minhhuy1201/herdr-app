# Track only files the person owns; Herdr writes the rest.
/*
!/.gitignore
!/docs/
!/README.md
!/GLOSSARY.md
!/keys.json
!/settings.json
!/programs.json
!/themes/
/themes/*
!/themes/github-dark.json
!/layouts/
/layouts/*
!/layouts/better-main.json
!/mods/
/mods/*
!/mods/better-changes/
!/mods/better-sidebar/
!/mods/git-graph/
!/mods/my-files/
!/mods/my-tabs/
gpui-kit.d.ts
herdr.d.ts
jsconfig.json
